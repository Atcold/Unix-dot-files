# macOS-only ssh options, kept out of ssh_config so Termux's OpenSSH parses the
# shared file at all. The Include must sit above every Host line: ssh parses an
# included file in the context where the Include sits, and ignores Host lines of
# its own when the Include falls inside some Host block
Include ~/.ssh/config.local

# UseKeychain and AddKeysToAgent are macOS ssh options: Termux's OpenSSH rejects
# them at parse time, even under a Match it wouldn't apply, so they live in
# ssh_config.local, included above and linked only on the Macs, as tmux.conf
# sources its mac.conf only on Darwin
Host github.com
  IdentityFile ~/.ssh/id_ed25519

Host cims
    HostName access.cims.nyu.edu
    Port 22
    Compression yes
    User ac7181
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent yes
    ServerAliveInterval 60

Host cassio rose* lion* vine* hpc* weaver*
    HostName %h.cs.nyu.edu
    ProxyJump cims
    StrictHostKeyChecking no

Host mybox
    HostName box795.cims.nyu.edu
    ProxyJump cims

Host localhost
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host alfdroid
    Port 8022

Include ~/.ssh/config.local
