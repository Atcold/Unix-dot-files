# Mac-only settings; the shared ones are in Bash/bashrc, loaded at the end

# System #######################################################################
# Load Homebrew first: the lines below call `brew --prefix`
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/Homebrew/bin/brew ]; then
    eval "$(/usr/local/Homebrew/bin/brew shellenv)"
else
    echo "brew not found :/"
fi

# Fix Catalina zsh shit warning
export BASH_SILENCE_DEPRECATION_WARNING=1

# Aliases and shortcuts ########################################################
alias lsv='gls -vX --color=auto'  # GNU ls with natural version sort
alias eject='diskutil eject'
alias skim='open -a /Applications/Skim.app'
alias preview='open -a /Applications/Preview.app'
alias screen-off='pmset displaysleepnow'
alias ql='qlmanage -p &>/dev/null'  # brew install syntax-highlight
alias bat='bat --paging=always'
xxd() { if [[ -t 1 ]]; then command xxd -R always "$@"; else command xxd "$@"; fi; }  # colour on screen only

# Claude Code from an SSH shell with token in the keychain
claude-ssh() {
    security unlock-keychain ~/Library/Keychains/login.keychain-db &&
    claude "$@"
}

# Pair the phone with this Mac's OpenCode server over Tailscale only
function opencode-pair {
    local ip="$(tailscale ip -4)"
    [[ "$ip" ]] || { echo "tailscale is not up" >&2; return 1; }
    opencode service set hostname "$ip"  # listen on the tailnet address only
    opencode service start               # service set stops the server; start applies the new config
    opencode pair | sed -E "s#(https?://)(127\.0\.0\.1|localhost)#\1$ip#"  # rewrite the link so the phone can reach it
}

# Undo opencode-pair: bind the server back to localhost, run it while the buddy is idle
function opencode-unpair {
    opencode service unset hostname  # the config change stops the server
    opencode service start           # start it again on localhost only
    opencode service status          # expect http://127.0.0.1:49374
}

# Mount CIMS on my Mac
