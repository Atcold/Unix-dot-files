# Updates ######################################################################
# Update everything: Homebrew, TeX Live, ble.sh, and Claude Code
function update-all {
    brew update && brew upgrade --yes
    sudo tlmgr update --self --all --reinstall-forcibly-removed
    [[ ${BLE_VERSION-} ]] && ble-update
    claude update
}

source "$HOME/.settings/Bash/bashrc"
source "$HOME/.settings/Mac/para.sh"   # p, a, r: jump into ~/PARA

# gog keeps its Google tokens in its own encrypted file; the password lives in the keychain, read by Apple's security tool
export GOG_KEYRING_BACKEND=file
export GOG_KEYRING_PASSWORD="$(security find-generic-password -s gog-keyring -w 2>/dev/null)"
