# Load the CIMS login defaults before the shared Linux settings.
export TERM=screen-256color
if [ -r /usr/local/lib/.system.bashrc ]; then
    source /usr/local/lib/.system.bashrc
fi > /dev/null

source "$HOME/.settings/Linux/bashrc"

# Let less apply the configured man-page colours.
export GROFF_NO_SGR=1

# Editor #######################################################################
export EDITOR="vim"
alias vim='TERM=xterm-256color /usr/bin/vim'

# Aliases and shortcuts ########################################################
alias l1='l -1'
# alias tmux="TERM=xterm-256color $HOME/local/bin/tmux"
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias tree='tree -C'

# Highlight numbers when displaying text files
alias v="grep --colour=always -nTP '(?<![\w\.])[-+]?[0-9]*[\.eE]?\-?[0-9]+|$'"
# Send v output to less
function lv {
    v $1 | less -R
}
# Convert CSV to TSV and send to lv
function cv {
    column -ts, $1 | lv
}

# Fix CIMS defaults ############################################################
unalias mv rm 2>/dev/null  # CIMS sets them only in interactive shells
export PROMPT_COMMAND=""

# NYU and CIMS hosts ###########################################################
# Some useful EXPORTs
export L1='lion1.'$CS
export L2='lion2.'$CS
export L3='lion3.'$CS
export L4='lion4.'$CS
export L5='lion5.'$CS
export L6='lion6.'$CS

# and corresponding ALIASes
alias L1="ssh $L1"
alias L2="ssh $L2"
alias L3="ssh $L3"
alias L4="ssh $L4"
alias L5="ssh $L5"
alias L6="ssh $L6"

# with X forwarding
alias L1X="ssh $L1 -Y"
alias L2X="ssh $L2 -Y"
alias L3X="ssh $L3 -Y"
alias L4X="ssh $L4 -Y"
alias L5X="ssh $L5 -Y"
alias L6X="ssh $L6 -Y"

# Slurm and Jupyter ############################################################
# alias Gpu="srun --qos=interactive --gres=gpu:1 --exclude=rose[1-4,7-9] --pty bash"
alias Gpu="srun --qos=interactive --gres=gpu:1 --pty bash"

# Run once: $ jupyter notebook password
function nb {
    echo "Exporting XDG variable, starting up Jupyter Notebook"
    echo -ne '  > on your local machine run: \033[1;32m$\033[0m '
    echo "nb $(hostname --short)"
    export XDG_RUNTIME_DIR=""
    jupyter notebook --no-browser --ip 0.0.0.0
}
function lab {
    echo "Exporting XDG variable, starting up Jupyter Lab"
    echo -ne '  > on your local machine run: \033[1;32m$\033[0m '
    echo "nb $(hostname --short)"
    export XDG_RUNTIME_DIR=""
    jupyter lab --no-browser --ip 0.0.0.0
}

# Environment ##################################################################
# Set correct permissions
umask 007

# Set up Singularity
export SINGULARITY_BIND="/misc"
