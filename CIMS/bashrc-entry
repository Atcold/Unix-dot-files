# Fool others to think TERM=screen-256color in Tmux
# [ -n "$TMUX" ] && export TERM=screen-256color
export TERM=screen-256color

# Get CIMS defaults

if [ -r /usr/local/lib/.system.bashrc ] ; then
    . /usr/local/lib/.system.bashrc
fi > /dev/null  # quiet mode
#clear

# Make individual customizations, such as aliases, below.


# My configurations
source $HOME/.settings/CIMS/bashrc



