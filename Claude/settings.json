{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git s)",
      "Bash(git lg -4)",
      "Bash(tmux send-keys *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"This session runs on $(scutil --get LocalHostName 2>/dev/null || hostname -s).\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/writing-check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
