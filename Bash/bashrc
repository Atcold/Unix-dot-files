# ble.sh: attach last (the platform file loads it first); no "-- INSERT --" line
if [[ ${BLE_VERSION-} ]]; then
    bleopt keymap_vi_mode_show:=   # ':=' because the vi keymap loads later
    bleopt complete_auto_complete:=   # no grey suggestions while typing; Tab still completes
    # Cursor: block in normal and visual mode, bar | in insert mode
    function blerc/vi-cursors {
        ble-bind -m vi_nmap --cursor 2
        ble-bind -m vi_xmap --cursor 2
        ble-bind -m vi_imap --cursor 5
    }
    blehook/eval-after-load keymap_vi blerc/vi-cursors
    # Multi-line commands: Enter indents line 2 by 2 spaces, under the `$ ` prompt;
    # later lines inherit it through vi_imap auto-indent
    function ble/widget/blerc/newline-ps2-indent {
        ble/widget/vi_imap/newline
        local before=${_ble_edit_str::_ble_edit_ind}
        local breaks=${before//[!$'\n']}
        ((${#breaks} == 1)) && ble/widget/.insert-string '  '
        return 0
    }
    function blerc/vi-newline {
        ble-bind -m vi_imap -f 'C-m' 'accept-single-line-or blerc/newline-ps2-indent'
        ble-bind -m vi_imap -f 'RET' 'accept-single-line-or blerc/newline-ps2-indent'
    }
    blehook/eval-after-load keymap_vi blerc/vi-newline
    ble-attach
fi
