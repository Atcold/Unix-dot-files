# Shared Bash settings, loaded at the end of Mac/bashrc and Linux/bashrc. Those
# load ble.sh first and set what differs per platform; this file attaches ble.sh last.

# Improvind Bash ###############################################################
alias grep='grep --colour=auto'
if command -v eza >/dev/null; then
    alias ls='eza --icons=auto --group-directories-first --sort=extension'
    alias ll='eza -l --icons=auto --git --group-directories-first --sort=extension'
    alias l='eza --icons=auto -F --group-directories-first --sort=extension'
    alias lt='eza --tree --icons=auto --level=2 --group-directories-first'
fi
alias ip='ipython --no-banner'
alias pip-update="pip install --upgrade pip && pip freeze --local | grep -v \
'^\-e' | cut -d = -f 1  | xargs -n1 pip install -U"
alias latex-update='sudo tlmgr update --self --all --reinstall-forcibly-removed'
alias py='python'
alias jn='jupyter notebook'
alias jl='jupyter lab'
alias pl='ip --pylab'
alias   ..='cd ../'
alias  ...='cd ../../'
alias ....='cd ../../../'
alias   .3='cd ../../../'
alias   .4='cd ../../../../'
alias   .5='cd ../../../../../'
alias cca='claude --permission-mode auto'  # Claude Code, auto mode
# t1–t5: show tree of current dir up to depth N (e.g. t2 shows 2 levels)
_t() { local dir="$(basename "$PWD")"; (cd .. && tree -L "$1" "$dir"); }
for i in 1 2 3 4 5; do
  alias "t$i"="_t $i"
done

# Bare `tmux` attaches to (or creates) a session named "Tmux", not "0"
# `command` skips this function, so we call the real binary and not ourselves
function tmux {
    if [ $# -eq 0 ]; then
        command tmux new-session -A -s Tmux
    else
        command tmux "$@"
    fi
}

# Create ssh tunnel via cims for Jupyter Notebook
# Run as: nb server_name
function nb {
    if [ -z "$1" ]; then
        echo -e '  > run as: \033[1;32m$\033[0m nb <my_server>'
        return
    fi
    echo "Connecting http://localhost:8000 -> $1:8888"
    read < <( ssh -NCqL 8000:localhost:8888 $1 & echo $! )
    echo "Done. PID = $REPLY"
}

# Connect remote server port 22 to localhost port 6000 for PyCharm
# Run as: pycharm server_name
function PyCharm {
    if [ -z "$1" ]; then
        echo -e '  > run as: \033[1;32m$\033[0m PyCharm <my_server>'
        return
    fi
    echo "Connecting localhost:6000 -> $1:22"
    read < <( ssh -NCqL 6000:localhost:22 $1 & echo $! )
    echo "Done. PID = $REPLY"
}

# Coloured LESS (MAN) pages
export LESS_TERMCAP_mb=$(printf '\e[01;31m') # enter blinking mode – red
export LESS_TERMCAP_md=$(printf '\e[01;35m') # enter double-bright mode – bold, magenta
export LESS_TERMCAP_me=$(printf '\e[0m') # turn off all appearance modes (mb, md, so, us)
export LESS_TERMCAP_se=$(printf '\e[0m') # leave standout mode
export LESS_TERMCAP_so=$(printf '\e[01;33m') # enter standout mode – yellow
export LESS_TERMCAP_ue=$(printf '\e[0m') # leave underline mode
export LESS_TERMCAP_us=$(printf '\e[04;36m') # enter underline mode – cyan

# Use Vim key binding in Bash and editor
set -o vi
export EDITOR="nvim"
export VISUAL="nvim"

# On Tab, fill the longest common prefix and list all matches at once
# (default `complete`, made eager so it shows the list instead of beeping)
bind 'set show-all-if-ambiguous on'
# And Shift-Tab should cycle backwards (vi-insert keymap: \e otherwise drops
# us into command mode before the [Z arrives)
bind -m vi-insert '"\e[Z": menu-complete-backward'
# Ctrl-W deletes back to the previous non-alphanumeric (e.g. /), like Vim —
# instead of the default unix-word-rubout which eats the whole path
bind -m vi-insert '"\C-w": backward-kill-word'

# Fuzzy completion via fzf (installed by install.sh)
# - **<Tab> → fuzzy-pick anywhere a path is expected (e.g. ln -s ~/Work/**<Tab>)
# - Ctrl-T  → fuzzy-find a file/dir and paste it into the current command
# - Ctrl-R  → fuzzy history search
# - Alt-C   → fuzzy cd into a subdir
if [[ ${BLE_VERSION-} ]]; then           # under ble.sh, its own fzf integration
    ble-import -d integration/fzf-completion
    ble-import -d integration/fzf-key-bindings
else
    command -v fzf >/dev/null && eval "$(fzf --bash)"
fi

# Git settings #################################################################
# The platform file may set $name (e.g. the Mac's computer name)
name=${name:-$(hostname -s)}

function parse_git_dirty {
  [[ $(git status 2> /dev/null | tail -n1) != "nothing to commit, working tree clean" ]] && echo "*"
}
function parse_git_branch {
    git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e "s/* \(.*\)/⎇ \1$(parse_git_dirty)/"
}
# After `clear` in tmux, ble.sh can redraw the first line one column over. The leading
# `\r` returns to column 1; `\[` and `\]` mark it as zero-width for prompt layout.
export PS1="\[\r\]\[\e[1;35m\]\u\[\e[38;5;255m\]@\[\e[1;34m\]$name \
\[\e[1;33m\]\w\[\e[0m\] \[\e[2m\]\$(parse_git_branch)\[\e[0m\]\n\[\e[1;32m\]$\[\e[0m\] "
export PS2="\[\e[1;31m\]>\[\e[0m\] "
export PAGER="less -R"

